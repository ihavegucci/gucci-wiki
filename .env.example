# ─────────────────────────────────────────────────────────────────────────────
#  gucci-wiki — образец файла окружения
#
#  Скопируйте в .env и поправьте значения:   cp .env.example .env
#  Настоящий .env в репозиторий не коммитится (см. .gitignore).
#
#  Для `docker compose up` файл создавать НЕ обязательно: у всех переменных
#  ниже есть рабочие значения по умолчанию. Он нужен, чтобы поменять
#  умолчания и чтобы запустить приложение без Docker.
#
#  Переменных три набора, и они не взаимозаменяемы:
#    1. Приложение   — читает код (process.env).
#    2. Compose      — подставляются в docker-compose.yml при запуске.
#    3. GitHub Secrets — только для деплоя (SSH_HOST, SSH_KEY, DOMAIN и т.д.).
#       В .env они бесполезны: ни приложение, ни compose их не читают.
#       Полный список — в README, раздел «Переменные окружения».
# ─────────────────────────────────────────────────────────────────────────────


# ═══ 1. Приложение ═══════════════════════════════════════════════════════════

# [ОБЯЗАТЕЛЬНО вне Docker] Строка подключения к Postgres.
# Внутри docker compose собирается автоматически из POSTGRES_* ниже —
# там эту переменную задавать не нужно.
DATABASE_URL="postgresql://gucci:gucci@localhost:5432/gucci_wiki"

# [ОБЯЗАТЕЛЬНО на проде] Секрет подписи сессионной cookie.
# Сгенерировать:  openssl rand -hex 32
# Смена значения разлогинивает всех пользователей.
SESSION_SECRET="change-me-to-a-long-random-string"

# [РЕКОМЕНДУЕТСЯ на проде] Ключ шифрования секретов, которые хранятся в БД:
# ключи доступа к S3 и токен Telegram-бота, введённые в /settings.
# Сгенерировать:  openssl rand -base64 48
#
# Зачем: суточный автобэкап базы уезжает в тот же S3-бакет, и без шифрования
# утечка одного дампа отдаёт сразу и доступ к бакету, и токен бота.
#
# Пустой  — секреты хранятся открытым текстом, приложение работает как обычно.
# Задан   — значения шифруются при первом сохранении настроек в /settings,
#           то есть после добавления ключа настройки нужно один раз
#           пересохранить, иначе старые значения останутся открытыми.
# Потерян — данные вики целы; настройки S3 и бота станут «не настроено»,
#           их нужно ввести заново в /settings.
SETTINGS_KEY=""

# [ОПЦИОНАЛЬНО] Адрес, по которому вика доступна снаружи.
# Нужен для абсолютных ссылок в сообщениях Telegram-бота, регистрации вебхука
# и проверки срока TLS-сертификата мониторингом.
# Не задан — берётся заголовок Host запроса.
# При деплое через CI подставляется автоматически из секрета DOMAIN.
APP_ORIGIN=""

# [ОПЦИОНАЛЬНО] Секрет для внешнего вызова POST /api/freshness/recalculate
# (заголовок X-Cron-Secret) — если хотите запускать пересчёт свежести статей
# со стороны, своим расписанием.
# Не задан — эндпоинт доступен только администратору с активной сессией,
# а сам пересчёт и так идёт фоновым таймером раз в 6 часов.
CRON_SECRET=""

# [ОПЦИОНАЛЬНО] Порог уверенности поиска (ранг Postgres ts_rank).
# Выше порога поиск показывает прямую цитату-ответ абзацем, ниже — обычный
# список ссылок. Многословный точный запрос даёт ~0.43, общее однословное
# совпадение — ~0.08–0.10.
# Поднять — если в ответы попадают нерелевантные абзацы.
# Опустить — если цитата почти никогда не показывается.
SEARCH_CONFIDENCE_THRESHOLD="0.2"


# ═══ 2. Docker Compose ═══════════════════════════════════════════════════════
# Читаются docker-compose.yml, а не кодом приложения.

# [ОПЦИОНАЛЬНО локально, ОБЯЗАТЕЛЬНО на проде] Учётные данные Postgres.
# На боевом сервере задайте свой пароль, а не значение по умолчанию.
POSTGRES_USER="gucci"
POSTGRES_PASSWORD="gucci"
POSTGRES_DB="gucci_wiki"

# [ОБЯЗАТЕЛЬНО на сервере] Порт на хосте, по которому будет доступна вика.
# Внутри контейнера всегда 3000. Публикуется только на 127.0.0.1 — наружу
# приложение смотрит через nginx, не напрямую.
# Локально можно не задавать (compose подставит 3000), на сервере — обязательно:
# из этого же значения собирается upstream в конфиге nginx.
APP_PORT="3000"

# [НЕ ЗАДАВАЙТЕ ВРУЧНУЮ] Образ приложения.
# Локальный docker-compose.yml собирает образ сам; на сервере значение
# подставляет деплой (ghcr.io/<владелец>/<репозиторий>:<sha>).
# APP_IMAGE=""
