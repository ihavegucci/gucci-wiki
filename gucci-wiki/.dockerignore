# Всё, что не нужно для сборки образа. Каждая строка — меньше контекста,
# который Docker передаёт демону, и меньше слоёв, которые нечем оправдать.

# Зависимости и сборка ставятся внутри образа заново
node_modules
.next

# Секреты не должны попадать в образ даже случайно
.env
.env.*
!.env.example

# Тесты в рантайме не нужны
test
vitest.config.mts

# Документация, CI и инфраструктура сервера к сборке приложения отношения не имеют
docs
.github
deploy
README.md
LICENSE

# Прочее
.git
.gitignore
*.log
.DS_Store
docker-compose.yml
docker-compose.override.yml
