# Зависимости
/node_modules

# Сборка Next.js
/.next/
/out/

# Тесты
/coverage

# Переменные окружения. В репозиторий попадает только образец:
# настоящий .env содержит пароли и ключи и не коммитится никогда.
.env
.env.*
!.env.example

# Локальный оверрайд compose — у каждого разработчика свой
# (например, публикация порта Postgres наружу для удобства).
docker-compose.override.yml

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Системный мусор
.DS_Store
Thumbs.db

# Логи
*.log
npm-debug.log*

# Ключи и сертификаты — не место в репозитории
*.pem
*.key
