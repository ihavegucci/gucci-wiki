# Основной конфиг — ставится setup-server.sh после того, как сертификат
# Let's Encrypt уже получен (см. http-only.conf.template).
#
# __DOMAIN__ и __PORT__ подставляются setup-server.sh из переменных
# окружения DOMAIN/UPSTREAM_PORT — это не часть чистовика, каждый деплой
# задаёт свои значения (см. README «CI/CD и деплой»).
server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name __DOMAIN__;

    ssl_certificate     /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;

    # Общий лимит загрузки файлов — 200 МБ (lib/storage/limits.ts), с
    # небольшим запасом на накладные расходы multipart-запроса. Без этой
    # строки nginx сам режет запрос на 1 МБ (дефолт) ещё до Next.js — лимит
    # в приложении был бы недостижим.
    client_max_body_size 60m;

    # Ограничение частоты на логин/регистрацию (rate-limit.conf, зона
    # auth_limit) — location с более длинным префиксом матчится раньше
    # общего location / ниже. nodelay — не задерживать первые burst
    # запросов (иначе легитимный логин под всплеском ощутимо тормозит),
    # лишнее сверх rate+burst получает 503.
    location /api/auth/ {
        limit_req zone=auth_limit burst=10 nodelay;
        proxy_pass http://127.0.0.1:__PORT__;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Перетираем клиентский X-Forwarded-Host: приложение ему больше не
        # доверяет (lib/telegram/origin.ts), но и пропускать подделку внутрь
        # незачем.
        proxy_set_header X-Forwarded-Host $host;
    }

    location / {
        proxy_pass http://127.0.0.1:__PORT__;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Перетираем клиентский X-Forwarded-Host: приложение ему больше не
        # доверяет (lib/telegram/origin.ts), но и пропускать подделку внутрь
        # незачем.
        proxy_set_header X-Forwarded-Host $host;
    }
}
